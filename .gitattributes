# Automatically normalizes line breaks in text files.
* text=auto

# Files that MUST use LF because they run on Linux (containers, CI).
# A .sh file with CRLF breaks inside the container with an obscure error.
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.sql           text eol=lf
*.md            text eol=lf
*.mako          text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.env.example    text eol=lf

# Files that typically run on Windows and expect CRLF.
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binary files: Git should not attempt to convert anything.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.xlsx          binary
*.parquet       binary